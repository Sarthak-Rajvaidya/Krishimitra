# ---- Branding (configurable) ----
BRAND_NAME=KrishiMitra
VITE_BRAND_NAME=KrishiMitra

# ---- App ----
APP_ENV=development
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql+psycopg://krishimitra:krishimitra@localhost:5432/krishimitra

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=krishi_knowledge
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
# set to "hash" to use a deterministic offline embedder (tests / no model download)
EMBEDDING_BACKEND=sentence-transformers
# Minimum cosine similarity for a passage to count as evidence. Tune with the developer retrieval test.
RAG_MIN_SCORE=0.25

# ---- LLM providers (keys stay server-side only) ----
LLM_PROVIDER_ORDER=groq,mistral,gemini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_COOLDOWN_SECONDS=60
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Storage ----
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=8
KNOWLEDGE_DIR=./storage/knowledge

# ---- Crop Doctor model ----
MODEL_ARTIFACT_DIR=./ml/artifacts
MIN_CONFIDENCE_FOR_DISPLAY=0.5

# ---- Demo seed (LOCAL ONLY). Leave blank to auto-generate and print once. ----
DEMO_PASSWORD=

# ---- Security (REQUIRED in production) ----
# DATA_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
OTP_DEV_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
REDIS_URL=

# ---- Providers (all optional; app runs with console SMS / simulated payments) ----
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@krishimitra.local
PAYMENT_PROVIDER=simulated
COMMISSION_BP=500
POSTGRES_PASSWORD=change-me
